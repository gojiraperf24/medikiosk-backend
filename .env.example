# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/medikiosk_db
DATABASE_ECHO=False

# Server Configuration
DEBUG=True
API_V1_STR=/api/v1
PROJECT_NAME=MediKiosk Backend
PROJECT_VERSION=0.1.0
ENVIRONMENT=development

# Security
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
CORS_CREDENTIALS=True
CORS_METHODS=["*"]
CORS_HEADERS=["*"]

# AI/ML Services
# Bhashini API for Indian Language ASR/TTS
BHASHINI_API_KEY=your-bhashini-api-key
BHASHINI_API_URL=https://api.bhashini.gov.in
DEFAULT_LANGUAGE=hi

# OpenAI/LLM Configuration (for conversation engine)
OPENAI_API_KEY=your-openai-api-key
LLM_MODEL=gpt-4
TEMPERATURE=0.7

# OCR Configuration
TESSERACT_PATH=/usr/bin/tesseract  # Linux/Mac path

# Google Cloud (for document processing)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json
GCP_PROJECT_ID=your-gcp-project

# ABDM Configuration
ABDM_CLIENT_ID=your-abdm-client-id
ABDM_CLIENT_SECRET=your-abdm-client-secret
ABDM_BASE_URL=https://sandbox.abdm.gov.in
ABDM_GATEWAY_URL=https://sandbox.ndhm.gov.in

# HIS/Hospital System Integration
HIS_API_URL=http://localhost:8000
HIS_API_KEY=your-his-api-key

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Session Management
SESSION_TIMEOUT_MINUTES=30
MAX_UPLOAD_FILE_SIZE_MB=50

# Feature Flags
ENABLE_RED_FLAG_DETECTION=True
ENABLE_AYUSH_MODE=True
ENABLE_DOCUMENT_PROCESSING=True
ENABLE_ABDM_INTEGRATION=True

# Email Configuration (for notifications)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@medikiosk.app

# Monitoring & Observability
PROMETHEUS_ENABLED=True
SENTRY_DSN=

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=3600
